{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logru",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // 招待リンクは、OG タグを書き換えるために Worker を通す。#93
    "run_worker_first": ["/api/*", "/__/auth/*", "/invite/*"],
    // Worker から index.html を読み直し、OG タグだけ書き換えて返すための束縛。#93
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logru",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 手元の開発。Firebase はエミュレーターを使う。demo- で始まるプロジェクトは本物に届かない
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:5173",
    "FIREBASE_PROJECT_ID": "demo-logru",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
    // 外部のカレンダーの URL を暗号にする鍵。手元の開発だけで使う値。本番は `wrangler secret put` で別の値を置く
    "EXTERNAL_CALENDAR_KEY": "A1lHffWgU+kOnJWlq6FGLBf/FWjnKGDp6cGYq5fvPnQ=",
    // 思い出の写真の URL に付ける署名の鍵。手元の開発だけで使う値。本番は `wrangler secret put` で別の値を置く
    "MEMORIES_PHOTO_KEY": "dev-only-memories-photo-key-change-me-in-production",
    // アバターの写真の URL に付ける署名の鍵。思い出とは別の鍵にする。手元の開発だけで使う値。本番は `wrangler secret put` で別の値を置く。#40
    "AVATAR_PHOTO_KEY": "dev-only-avatar-photo-key-change-me-in-production",
    // 端末への知らせの VAPID の鍵。手元の開発だけで使う組。本番は公開鍵を env.production.vars に、秘密鍵を `wrangler secret put VAPID_PRIVATE_KEY` で置く
    "VAPID_PUBLIC_KEY": "BPUm_oLClft9DRthvDIJ303Z0PABoblpADTHcpnZtA0zpfzPQQvBFAfi6afKxM4dsTjIbTqkEH9MCj3xFw6hBOs",
    "VAPID_PRIVATE_KEY": "i5Zr5HBvx46JLosvvrcZDcLGQt2dfRRa87Zq52NLeMc",
    "VAPID_SUBJECT": "mailto:tkkwkut@gmail.com"
  },
  // 思い出とアバターの写真の置き場。手元では Miniflare が .wrangler の下に作る
  "r2_buckets": [
    { "binding": "MEMORIES_BUCKET", "bucket_name": "logru-memories" },
    { "binding": "AVATAR_BUCKET", "bucket_name": "logru-avatars" }
  ],
  // 外部のカレンダーを 5 分おきに読み直す
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        // Firebase のプロジェクト ID は、作ったものに書き換える。README の「本番に出す」を参照
        "APP_URL": "https://logru-production.tkkwkut-400.workers.dev",
        "FIREBASE_PROJECT_ID": "logre-c9505",
        "FIREBASE_AUTH_EMULATOR_HOST": "",
        // EXTERNAL_CALENDAR_KEY は秘密なので、ここに書かず `wrangler secret put EXTERNAL_CALENDAR_KEY --env production` で置く
        // MEMORIES_PHOTO_KEY も同じく `wrangler secret put MEMORIES_PHOTO_KEY --env production` で置く
        // AVATAR_PHOTO_KEY も同じく `wrangler secret put AVATAR_PHOTO_KEY --env production` で置く。#40
        // VAPID の組は README の「本番に出す」で作る。公開鍵だけをここに書き、秘密鍵は `wrangler secret put VAPID_PRIVATE_KEY --env production`
        "VAPID_PUBLIC_KEY": "BFjMYKGKpbDkPXxwXkZIqXZ61MOxLAq3De6rV8roskIT72AjFT7K82l6iEFqxEcES0goFvSg-4Me9a4S-G3fYnY",
        "VAPID_SUBJECT": "mailto:tkkwkut@gmail.com"
      },
      "r2_buckets": [
        { "binding": "MEMORIES_BUCKET", "bucket_name": "logru-memories" },
        { "binding": "AVATAR_BUCKET", "bucket_name": "logru-avatars" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logru",
          // `wrangler d1 create logru` の結果に置き換える
          "database_id": "d1ec84e4-bb34-4aaa-8847-da5c9031c18f",
          "migrations_dir": "migrations"
        }
      ],
      // 利用者ごとの回数の上限。手元の開発と E2E には置かない。束縛が無ければ数えずに素通りする。#94、0045、0065
      "ratelimits": [
        { "name": "PHOTO_RATE_LIMIT", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
        { "name": "INVITE_RATE_LIMIT", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } },
        { "name": "CALENDAR_SYNC_RATE_LIMIT", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "WEATHER_RATE_LIMIT", "namespace_id": "3004", "simple": { "limit": 30, "period": 60 } },
        // IP を key にする。ログイン前にも呼べる入り口なので、利用者の ID を使えない。0065、#161
        { "name": "CLIENT_ERROR_RATE_LIMIT", "namespace_id": "3005", "simple": { "limit": 20, "period": 60 } }
      ]
    },
    // 本番の手前で確かめる環境。develop に入ると自動で出る。データと鍵は本番と分け、Firebase だけ本番と同じプロジェクトを使う
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        // Firebase のプロジェクト ID は本番と同じ値にする
        "APP_URL": "https://logru-staging.tkkwkut-400.workers.dev",
        "FIREBASE_PROJECT_ID": "logre-c9505",
        "FIREBASE_AUTH_EMULATOR_HOST": "",
        // 秘密の 4 つは本番と別の値を `wrangler secret put <名前> --env staging` で置く。VAPID の組も本番と分ける
        "VAPID_PUBLIC_KEY": "BIwBq_YWW08NYgXRsec50Cijzku_YwUMsN-aiy7Lw16qFwm0cdde7jtyV1sQ8P6q_WVFrCKQkO_2jc6WmAvu5mQ",
        "VAPID_SUBJECT": "mailto:tkkwkut@gmail.com"
      },
      "r2_buckets": [
        { "binding": "MEMORIES_BUCKET", "bucket_name": "logru-memories-staging" },
        { "binding": "AVATAR_BUCKET", "bucket_name": "logru-avatars-staging" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logru-staging",
          // `wrangler d1 create logru-staging` の結果に置き換える
          "database_id": "9b7333a0-d07b-4fd0-896f-42f177ce9531",
          "migrations_dir": "migrations"
        }
      ],
      // 本番と同じ束縛の名前。namespace_id は本番と重ならない番号にする。#94、0045、0065
      "ratelimits": [
        { "name": "PHOTO_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "INVITE_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        { "name": "CALENDAR_SYNC_RATE_LIMIT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "WEATHER_RATE_LIMIT", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } },
        { "name": "CLIENT_ERROR_RATE_LIMIT", "namespace_id": "2005", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
