{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client"
    ],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "./src/client/*"
      ]
    }
  },
  "include": [
    "src/client",
    "src/shared",
    "src/extensions/types.ts",
    "src/extensions/registry.client.ts",
    "src/extensions/*/manifest.ts",
    "src/extensions/*/client",
    "src/extensions/*/shared",
    "tests/client"
  ]
}