# E2E テスト。本番と同じ形に組み立てるが、Firebase は Auth エミュレーターにつなぐ
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-logru.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-logru
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# 画面の案内の吹き出しが、ほかのテストの操作を隠さないように切る。F-33
VITE_TOURS=off
