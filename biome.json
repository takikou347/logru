{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!worker-configuration.d.ts", "!src/client/components/ui/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "preset": "recommended",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noSvgWithoutTitle": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/client/components/**/*.ts", "src/client/modules/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case", "export"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/components/**/*.tsx", "src/client/modules/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["PascalCase", "export"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*Page.tsx", "**/*Sheet.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/api/client": "画面(*Page.tsx、*Sheet.tsx)から直接読めない。機能ごとの api.ts からだけ import する"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@extensions/*/client",
                      "@extensions/*/client/**",
                      "@extensions/*/server",
                      "@extensions/*/server/**",
                      "@extensions/*/shared",
                      "@extensions/*/shared/**",
                      "**/extensions/*/client",
                      "**/extensions/*/client/**",
                      "**/extensions/*/server",
                      "**/extensions/*/server/**",
                      "**/extensions/*/shared",
                      "**/extensions/*/shared/**"
                    ],
                    "message": "src/server/ から拡張の中身を直接読めない。@extensions/server/registry と @extensions/types だけ許す"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
